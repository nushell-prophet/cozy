{
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "cleanupPeriodDays": 36500,
  "editorMode": "normal",
  "verbose": true,
  "promptSuggestionEnabled": false,
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": false,
  "permissions": {
    "ask": [
      "Bash(brew install *)",
      "Bash(brew reinstall *)",
      "Bash(brew upgrade*)",
      "Bash(brew tap *)",
      "Bash(cargo install *)",
      "Bash(npm install --global *)",
      "Bash(npm install -g *)",
      "Bash(go install *)",
      "Bash(uv tool install *)",
      "Bash(pipx install *)"
    ]
  },
  "env": {
    "EDITOR": "hx-quote",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/pinned-notes"
  }
}
