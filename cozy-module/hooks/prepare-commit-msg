#!/bin/sh
# Name the commit a revert undoes by its Change-Id, and give the revert an id of its own.
# Why the line above never changes: `cozy git install-change-id-hook` knows an installed copy as
# this hook by it and updates that copy; new wording makes every installed copy a foreign hook.
#
# Why this hook exists: `git revert` writes "This reverts commit <sha>." and never runs commit-msg.
# The next rebase leaves that sha naming a commit no branch holds, and the revert gets no id. This
# is the one message hook revert does run, so it rewrites the line and forwards to commit-msg.

set -e
msg="$1"

# Why CHERRY_PICK_HEAD stops it: rebase and cherry-pick replay old messages through this hook too.
# An old revert keeps the words it was committed with; stamping it would retrofit an id.
if [ -e "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ]; then
    exit 0
fi

# Why a prefix and not the whole line: `revert -m` appends ", reversing" and `--reference` appends
# "(<subject>, <date>)", and those reverts need an id as much as any other.
sha=$(sed -n 's/^This reverts commit \([0-9a-f]\{7,64\}\)[^0-9a-f].*$/\1/p' "$msg")
if [ -z "$sha" ]; then
    exit 0
fi

# Why two ids keep the sha: a commit that carries two names no single change, and `link` refuses it
# for the same reason.
id=$(git log -1 --format='%(trailers:key=Change-Id,valueonly)' "$sha" 2>/dev/null || true)
if [ -n "$id" ] && [ "$(printf '%s\n' "$id" | wc -l)" -eq 1 ]; then
    # Not `sed -i`: BSD sed on a macOS host reads its next argument as the backup suffix.
    sed "s/^This reverts commit $sha/This reverts change $id/" "$msg" >"$msg.tmp"
    mv "$msg.tmp" "$msg"
fi

exec "$(git rev-parse --git-path hooks/commit-msg)" "$msg"
