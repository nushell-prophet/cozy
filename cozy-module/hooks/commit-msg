#!/bin/sh
# Stamp a Change-Id trailer on a commit that does not already carry one.
# Why the line above never changes: `cozy git install-change-id-hook` knows an installed copy as
# this hook by it and updates that copy; new wording makes every installed copy a foreign hook.
#
# The id lives in the message, so amend, rebase and cherry-pick carry it forward by themselves.
# This hook therefore only ever adds one and never replaces one: replacing would break the single
# property the trailer exists for. See the "Change-Id" section of the mono-repo-tooling-spec specification.

set -e
msg="$1"

# Why: an amend that carries the old id with `--trailer "Change-Id: $(git log -1 ...)"` writes an
# empty trailer when HEAD has no id, and that empty trailer would pass the id check below.
# Why before the empty check: a message that is only that trailer is empty, and git must abort it.
# Not `sed -i`: BSD sed on a macOS host reads its next argument as the backup suffix.
sed '/^Change-Id:[[:space:]]*$/d' "$msg" >"$msg.tmp"
mv "$msg.tmp" "$msg"

# An empty message aborts the commit. Adding a trailer would make it non-empty and let an abort
# through as a commit with no subject, so a message that is only comments and blanks is left alone.
# Why the cut at the scissors line: `commit --verbose` puts the diff below it without comment
# marks, so an untouched template would count as a message. Git cuts there too before its check.
# Why any prefix: git writes the line with the configured comment character, and
# core.commentChar=auto or a multi-character core.commentString leave it unknowable here.
if [ -z "$(sed '/^.* -\{24\} >8 -\{24\}$/,$d' "$msg" | git stripspace --strip-comments)" ]; then
    exit 0
fi

if git interpret-trailers --parse <"$msg" | grep -q '^Change-Id:'; then
    exit 0
fi

# Why: `rebase --autosquash` puts the whole message of an `amend!` commit onto its target, so a
# fresh id here would replace the target's id. The target is resolved only when it is a commit
# name, `amend! <sha>`. Why one id only: a commit that carries two names no single change, as in
# prepare-commit-msg.
# Not by subject, as autosquash also matches: the hook cannot see the rebase range, so with two
# commits of one subject it can copy the id of the other one, and one id names two changes.
# A subject only costs a fresh id.
id=
subject=$(git stripspace --strip-comments <"$msg" | sed -n '1p')
case "$subject" in
'amend! '*)
    sha=$(git rev-parse --verify --quiet "${subject#amend! }^{commit}" 2>/dev/null || true)
    if [ -n "$sha" ]; then
        id=$(git log -1 --format='%(trailers:key=Change-Id,valueonly,separator=%x2C)' "$sha")
    fi
    case "$id" in *,*) id= ;; esac
    ;;
esac

# jj's reverse-hex alphabet: 12 random bytes and the unix time, written as 32 letters from z to k.
# Letters can never read as a git sha. The tr -d in the middle is not optional: tr translates only
# what it is given, so od's spaces would survive.
# Why the time is the tail and not the head: a reference cuts the id to its first 8 letters, and
# those stay random only while the random part leads. Why the time at all: the hook never replaces
# an id, so the tail records when the change was first committed, and a rebase or cherry-pick
# carries that date along with the id. %08x keeps the width until 2106.
if [ -z "$id" ]; then
    random=$(dd if=/dev/urandom bs=12 count=1 2>/dev/null | od -An -v -tx1 | tr -d ' \n')
    stamp=$(printf '%08x' "$(date +%s)")
    id=$(printf '%s%s' "$random" "$stamp" | tr '0123456789abcdef' 'zyxwvutsrqponmlk')
fi

# Why: interpret-trailers needs the last line terminated. `git merge --no-edit` writes its message
# without a final newline, and then the trailer lands on the subject line instead of in a block:
# `%(trailers)` reads nothing and the next amend mints a second id.
if [ -n "$(tail -c 1 "$msg")" ]; then
    printf '\n' >>"$msg"
fi

# interpret-trailers, not an append: where the body ends in prose it opens a block with a blank
# line, and where it already ends in a trailer block it joins that one. A hand-rolled append gets
# one of the two wrong, and then `git log --format=%(trailers:key=...)` reads back nothing.
git interpret-trailers --in-place --trailer "Change-Id: $id" "$msg"
